# 项目环境变量示例
# 复制为 .env（各端本地使用）或在部署/CI 时注入。
# 真实敏感值一律放在 secrets/config.yaml（已被 gitignore），不要写入本文件。

# ===== 后端（backend/）=====

# 配置加载优先级最高：指向具体配置文件
# CONFIG_PATH=./config/local.yaml

# 开发环境标记（为 'development' 时优先使用 backend/env.yaml）
# ENV=development

# 敏感配置合并路径（默认 <仓库根>/secrets/config.yaml）
# SECRETS_PATH=./secrets/config.yaml

# 生产环境 CORS 允许来源（逗号分隔），默认仅 localhost:5173/8000
# CORS_ORIGINS=https://media.example.com

# 远程数据库脚本凭据（backend/scripts 下涉及远程数据源的脚本使用）
# REMOTE_DB_HOST=
# REMOTE_DB_PORT=5432
# REMOTE_DB_NAME=
# REMOTE_DB_USER=
# REMOTE_DB_PASSWORD=

# ===== 前端（frontend/）=====

# API 基础地址。留空时走 Vite 开发代理（/api -> localhost:8000）
# VITE_API_BASE_URL=/api

# ===== 部署（deploy/）=====
# 见 deploy/.env.example
