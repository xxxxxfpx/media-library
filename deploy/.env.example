# 部署环境变量（示例）
# 复制为 deploy/.env 后使用，包含敏感信息，切勿提交。

# JWT 签名密钥（必填，启动守卫要求非空；缺失时入口脚本会拒绝启动）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# 管理员账号（首次启动自动创建）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# 123云盘 WebDAV 凭据
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_PREFIX=/🗂️ 整理/Emby

# 服务端口映射（仅绑定 localhost，由服务器 Caddy 反代 media.mz727.top 对外暴露）
BACKEND_PORT=1999
FRONTEND_PORT=3000

# 生产 CORS 允许来源（逗号分隔）
CORS_ORIGINS=https://media.mz727.top

# PostgreSQL（如使用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_db
DB_USER=media
DB_PASSWORD=change-me
