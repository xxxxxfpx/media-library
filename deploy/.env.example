# 部署环境变量（示例）
# 复制为 deploy/.env 后使用，包含敏感信息，切勿提交。
# 单镜像部署模式：镜像内含 FastAPI + SPA 静态资源，服务器只需 docker compose up

# 镜像地址（可通过 IMAGE 环境变量覆盖，默认指向阿里云镜像仓库 latest）
# IMAGE=crpi-7r0bt0szn4xpndx8.cn-hangzhou.personal.cr.aliyuncs.com/xiemingzhe/media:latest

# JWT 签名密钥（必填，启动守卫要求非空；缺失时入口脚本会拒绝启动）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# 管理员账号（首次启动自动创建）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# 123云盘 WebDAV 凭据
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_PREFIX=/🗂️ 整理/Emby

# 端口映射（仅绑定 localhost，由服务器 Caddy 反代 media.mz727.top 对外暴露）
BACKEND_PORT=1999

# 生产 CORS 允许来源（逗号分隔）
CORS_ORIGINS=https://media.mz727.top

# 可选：自定义挂载目录（默认相对 docker-compose.yml 所在目录）
# CONFIG_DIR=./config
# SECRETS_DIR=./secrets
# DATA_DIR=./data

# 可选：覆盖容器内路径（Dockerfile 已有合理默认）
# CONFIG_PATH=/app/config/default.yaml
# SECRETS_PATH=/app/secrets/config.yaml
