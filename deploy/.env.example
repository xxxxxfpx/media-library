# 部署环境变量（示例）
# 复制为 deploy/.env 后使用，包含敏感信息，切勿提交。

# 管理员账号（首次启动自动创建）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# 123云盘 WebDAV 凭据
CLOUD_USERNAME=
CLOUD_PASSWORD=
CLOUD_PREFIX=/🗂️ 整理/Emby

# PostgreSQL（如使用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_db
DB_USER=media
DB_PASSWORD=change-me
