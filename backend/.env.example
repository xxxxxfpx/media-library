# 后端运行时环境变量（示例）
# 复制为 backend/.env 或在部署时注入。

# 配置文件路径（优先级最高）。默认依次查找:
#   backend/config/local.yaml -> backend/config/default.yaml
# 开发/测试环境可指向 backend/env.yaml
# CONFIG_PATH=./config/local.yaml

# 开发环境标记（为 'development' 时优先使用 env.yaml）
# ENV=development

# 云盘等敏感配置合并路径（默认 backend/secrets/config.yaml）
# SECRETS_PATH=./secrets/config.yaml
